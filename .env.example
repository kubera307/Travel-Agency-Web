FLASK_ENV=development
PORT=5000
# Required outside development; use a long random value.
JWT_SECRET=
JWT_EXPIRES_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# Mock payments remain pending by default. Never enable mock approval in production.
PAYMENT_MODE=mock
MOCK_PAYMENT_AUTO_APPROVE=false

# Business details are intentionally empty until configured.
BUSINESS_PHONE=
WHATSAPP_NUMBER=
SUPPORT_EMAIL=
